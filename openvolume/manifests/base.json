{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "OpenVolume",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/cngil/openvolume",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "commands": {
    "volume-up": {
      "suggested_key": { "default": "Alt+Shift+Up" },
      "description": "__MSG_cmdUp__"
    },
    "volume-down": {
      "suggested_key": { "default": "Alt+Shift+Down" },
      "description": "__MSG_cmdDown__"
    },
    "volume-reset": {
      "suggested_key": { "default": "Alt+Shift+0" },
      "description": "__MSG_cmdReset__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
